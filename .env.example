# Variables del stack. Copiar a .env (ignorado por git) y ajustar:
#   copy .env.example .env

# Usuario root de MongoDB (12-Factor III: la configuracion sale del entorno,
# no del codigo). Son valores de desarrollo local: fuera de la PC, usar otra
# clave. Mongo crea el usuario solo la primera vez que inicializa el volumen:
# si se cambia la clave, recrear el volumen con docker compose down -v.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=9009

# Tags de las imagenes (12-Factor V): la version de cada servicio, la de su
# pyproject.toml. Subirlos en cada release para no pisar la imagen anterior.
ORCHESTRATOR_TAG=0.2.0
PDF_EXTRACTEXT_TAG=2.0.1
DOCUMENT_STORE_TAG=0.2.0

# Opcionales (12-Factor VII): puerto de cada servicio dentro de la red. Cada
# uno define PORT, el healthcheck, la label de Traefik y la URL que usa el
# orquestador para llamarlo. Sin definirlos, 8000.
# ORCHESTRATOR_PORT=8000
# PDF_EXTRACTEXT_PORT=8000
# DOCUMENT_STORE_PORT=8000

# Opcional: subred de la red del stack. El orquestador solo acepta los headers
# X-Forwarded-* de esta red (FORWARDED_ALLOW_IPS). Cambiarla solo si choca con
# otra red de la maquina (docker network inspect), y despues docker compose down.
# STACK_SUBNET=172.28.0.0/16
